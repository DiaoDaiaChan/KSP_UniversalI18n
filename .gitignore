# ===== 本仓库 =====
# 构建产物
build/
bin/
obj/
dist/
*.user
.vs/

# 临时与审计产物（不进仓库）
_scratch/
_audit/

# 机密与本地覆盖
.env
.env.local
*.local.json
secrets/

# 生成物：二进制字典包由 CI 产出，不手工提交
packs/*.uip
packs/**/*.bin

# python
__pycache__/
*.pyc
.pytest_cache/

# 大样本（可复现，10 个文件 19.6 MB，不入库）
reports/sample-*.jsonl

# IL 流水线的机械副产物（可由 translate_il.py 重跑再生，15 个文件 831 KB）
reports/il-provenance-*.jsonl
reports/il-sample*.jsonl
# 每次跑 translate_il 都会落一份的统计报告（可由命令重跑再生）
reports/translation-*.json

# 真实会话的缺失命中捕获（玩家数据，只留在本机 PluginData/UI18n）
PluginData/

# ===== .NET 通用（承接上游 GitHub .NET 模板）=====
# https://github.com/github/gitignore/blob/main/Dotnet.gitignore
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Ll]og/
[Ll]ogs/

*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/
Artifacts/
ScaffoldingReadMe.txt

# 测试与覆盖率
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
CodeCoverage/
*.VisualState.xml
TestResult.xml
nunit-*.xml
*.binlog
*.tlog

# 杂项
~$*
*~
