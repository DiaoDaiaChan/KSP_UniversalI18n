# build outputs
build/
bin/
obj/

# 发布产物（zip / manifest / netkan 由 build-release.ps1 生成，不入库）
dist/
*.user
.vs/

# 临时与审计产物（不进仓库）
_scratch/
_audit/

# 机密与本地覆盖
.env
.env.local
*.local.json
secrets/

# 生成物：字典包由 CI 产出，不手工提交
packs/*.uip
packs/**/*.bin

# python
__pycache__/
*.pyc
.pytest_cache/

# 大样本（可复现，10 个文件 19.6 MB，不入库）
reports/sample-*.jsonl

